# Copy to .env and fill in. Never commit .env.
REACTOR_API_KEY=rk_your_key_here

# Default model slug. Alternatives: reactor/lingbot, reactor/helios
WORLDGYM_MODEL=reactor/lingbot-world-2

# Optional: URL of a Modal-hosted DINOv2 embedding endpoint (see modal_app.py).
# When set, metrics.similarity() blends in embedding cosine similarity.
# WORLDGYM_EMBED_URL=https://<your-modal-app>.modal.run/embed

# Optional: for the Dream Navigator stretch goal (worldgym/agent.py)
# ANTHROPIC_API_KEY=sk-ant-...
